# Server
PORT=3000
HOST=0.0.0.0
# Frontend URL — set this to your deployed frontend domain in production
# In dev this defaults to http://localhost:5173 (no need to set it)
ALLOWED_ORIGIN=https://your-frontend-domain.pages.dev

# Queue
QUEUE_CAPACITY=100

# Worker pool
WORKER_COUNT=4
WORKER_POLL_INTERVAL_MS=100

# Simulated processing
PROCESSING_DELAY_MS=50
FAILURE_PROBABILITY=0.1
MAX_RETRIES=3
